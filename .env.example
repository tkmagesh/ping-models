GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_vocareum_api_key
GOOGLE_GEMINI_BASE_URL=https://gemini.vocareum.com

# Alternatively, you can set GEMINI_API_KEY instead of GOOGLE_API_KEY.
# The script in ping.py checks GEMINI_API_KEY first, then GOOGLE_API_KEY.
